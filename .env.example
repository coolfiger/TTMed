APP_NAME="TTMed"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://platform.ttmed.app
APP_TIMEZONE=America/Port_of_Spain

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Platform database (ttmed_platform)
DB_CONNECTION=platform
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ttmed_platform
DB_USERNAME=ttmed_platform_user
DB_PASSWORD=

# Tenant database provisioner credentials (MySQL user that can CREATE DATABASE / CREATE USER)
TENANT_DB_PROVISIONER_HOST=127.0.0.1
TENANT_DB_PROVISIONER_PORT=3306
TENANT_DB_PROVISIONER_USERNAME=ttmed_provisioner
TENANT_DB_PROVISIONER_PASSWORD=

# Encryption key for tenant DB passwords stored in platform DB (32 hex chars = 128-bit)
TENANT_ENCRYPTION_KEY=

# Tenancy
TENANT_DOMAIN=ttmed.app
PLATFORM_SUBDOMAIN=platform
TENANT_RESOLUTION=subdomain
TENANT_STORAGE_ROOT=/var/ttmed-storage

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true

# Cache / Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (SMTP2GO)
MAIL_MAILER=smtp
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ttmed.app"
MAIL_FROM_NAME="TTMed"

# Reverb (Laravel WebSocket server)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Platform admin seed credentials (used by PlatformSeeder only)
PLATFORM_ADMIN_EMAIL=admin@ttmed.app
PLATFORM_ADMIN_PASSWORD=changeme123!

# Error monitoring (Sentry)
# Get your DSN from sentry.io → Project Settings → Client Keys
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Backups — number of daily backups to retain per tenant
BACKUP_TENANT_KEEP_DAYS=7

# SMTP2GO webhook signing secret (Settings → Webhook → Secret)
SMTP2GO_WEBHOOK_SECRET=
